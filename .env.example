# Optional canonical production URL (canonical, Open Graph, robots.txt and sitemap.xml)
# VITE_SITE_URL=https://palco.yourdomain.com

# WebRTC ICE servers (comma-separated STUN URLs or RTCIceServer[] JSON)
VITE_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478

# Peer ID prefix (handy for separating dev/staging/prod)
VITE_PEER_ID_PREFIX=palco-v1-

# Max PDF file size in MB
VITE_MAX_PDF_MB=100

# Guest connection timeout and reconnect backoff (ms)
VITE_GUEST_CONNECT_TIMEOUT_MS=14000
VITE_MAX_RECONNECT_ATTEMPTS=4
VITE_RECONNECT_DELAY_MS=1800

# Optional self-hosted PeerServer (uses public PeerServer when omitted)
# VITE_PEER_HOST=peer.yourdomain.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/peerjs
# VITE_PEER_SECURE=true
